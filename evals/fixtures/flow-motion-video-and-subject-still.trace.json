                "typeId": "flow.asset.static",
                "config": { "modality": "video", "mediaItemId": "media-motion" }
              }
            }
          ]
        }
      }
    },
    {
      "type": "tool_call",
      "tool": "flow_capabilities_get",
      "input": {
        "typeId": "flow.asset.static",
        "config": { "modality": "video", "mediaItemId": "media-motion" }
      }
    },
    {
      "type": "tool_call",
      "tool": "flow_media_input_set",
      "input": {
        "flowId": "flow-1",
        "expectedRevision": "r5",
        "nodeId": "subject-source",
        "mediaItemId": "media-subject",
        "expectedModality": "image"
      }
    },
    {
      "type": "tool_result",
      "tool": "flow_media_input_set",
      "output": { "graphRevision": "r6", "media": { "modality": "image" } }
    },
    {
      "type": "tool_call",
      "tool": "flow_get",
      "input": { "flowId": "flow-1" }
    },
    {
      "type": "tool_result",
      "tool": "flow_get",
      "output": { "graphRevision": "r6" }
    },
    {
      "type": "tool_call",
      "tool": "flow_capabilities_get",
      "input": {
        "typeId": "flow.asset.static",
        "config": { "modality": "image", "mediaItemId": "media-subject" }
      }
    },
    {
      "type": "tool_call",
      "tool": "flow_nodes_connect",
      "input": {
        "flowId": "flow-1",
        "expectedRevision": "r6",
        "sourceNodeId": "motion-source",
        "sourcePortId": "output",
        "targetNodeId": "subject-motion",
        "targetPortId": "referenceVideo"
      }
    },
    {
      "type": "tool_result",
      "tool": "flow_nodes_connect",
      "output": { "graphRevision": "r7" }
    },
    {
      "type": "tool_call",
      "tool": "flow_nodes_connect",
      "input": {
        "flowId": "flow-1",
        "expectedRevision": "r7",
        "sourceNodeId": "subject-source",
        "sourcePortId": "output",
        "targetNodeId": "subject-motion",
        "targetPortId": "reference"
      }
    },
    {
      "type": "tool_result",
      "tool": "flow_nodes_connect",
      "output": { "graphRevision": "r8" }
    },
    {
      "type": "tool_call",
      "tool": "flow_validate",
      "input": { "flowId": "flow-1" }
    },
    {
      "type": "tool_result",
      "tool": "flow_validate",
      "output": { "ok": true, "graphIssues": [], "mediaInputs": [] }
