    {
      "type": "tool_result",
      "tool": "flow_media_input_set",
      "output": { "graphRevision": "r5", "media": { "modality": "video" } }
    },
    {
      "type": "tool_call",
      "tool": "flow_get",
      "input": { "flowId": "flow-1" }
    },
    {
