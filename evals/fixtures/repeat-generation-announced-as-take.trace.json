{
  "scenarioId": "repeat-generation-announced-as-take",
  "host": "external-mcp-client",
  "events": [
    {
      "type": "tool_call",
      "tool": "workspace_read_entity",
      "input": {
        "projectId": "project-1",
        "entityId": "entity-nia"
      }
    },
    {
      "type": "tool_call",
      "tool": "media_list_project",
      "input": {
        "projectId": "project-1",
        "sourceId": "entity-nia",
        "sourceTable": "agent_workspace_entities",
        "type": "image"
      }
    },
    {
      "type": "tool_call",
      "tool": "workspace_execute_command",
      "input": {
        "type": "entity.generateHero",
        "projectId": "project-1",
        "entityId": "entity-nia",
        "operationKey": "image.generate",
        "inputs": {
          "prompt": "Take 3: same identity lock framing and neutral background; the only change is soft window light from frame left instead of overhead."
        }
      }
    },
    {
      "type": "tool_call",
      "tool": "task_get",
      "input": {
        "taskId": "hero-take-3"
      }
    },
    {
      "type": "tool_call",
      "tool": "media_list_project",
      "input": {
        "projectId": "project-1",
        "sourceId": "entity-nia",
        "sourceTable": "agent_workspace_entities",
        "type": "image"
      }
    }
  ]
}
